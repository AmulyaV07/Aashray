<!DOCTYPE html>
<html lang="en">

<head>

    <title>Login | AASHRAY</title>

    <%- include("../partials/head") %>

</head>

<body class="bg-stone-900 text-stone-200 font-[Inter] antialiased selection:bg-teal-100 selection:text-teal-900">

    <%- include("../partials/navbar") %>

    <main class="min-h-[85vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
        
        <!-- Background decorative blobs -->
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-teal-100 rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob"></div>
        <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-emerald-100 rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-8 left-1/3 w-96 h-96 bg-amber-50 rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob animation-delay-4000"></div>

        <div class="w-full max-w-md bg-stone-900/80 backdrop-blur-xl border border-white rounded-[2rem] shadow-xl p-8 sm:p-10 relative z-10">

            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-teal-50 text-teal-600 mb-6 shadow-sm border border-teal-100">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                </div>
                <h1 class="text-3xl font-extrabold text-stone-100 tracking-tight">
                    Welcome Back
                </h1>
                <p class="text-stone-300 mt-2">
                    Login to continue to AASHRAY.
                </p>
            </div>

            <form action="/auth/login" method="POST" class="space-y-6">

    <div>
        <label class="block mb-2 text-sm font-semibold text-stone-200">
            Email Address
        </label>

        <input
            type="email"
            name="email"
            placeholder="name@example.com"
            class="w-full rounded-xl bg-stone-900 border border-stone-800 px-4 py-3.5 text-stone-200 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200"
            required
        >
    </div>

    <div>
        <label class="block mb-2 text-sm font-semibold text-stone-200">
            Password
        </label>

        <input
            type="password"
            name="password"
            placeholder="••••••••"
            class="w-full rounded-xl bg-stone-900 border border-stone-800 px-4 py-3.5 text-stone-200 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200"
            required
        >
    </div>

    <button
        type="submit"
        class="w-full bg-teal-600 hover:bg-teal-700 text-white transition-all duration-300 rounded-xl py-3.5 font-bold cursor-pointer shadow-lg shadow-teal-600/20 hover:shadow-teal-600/40 hover:-translate-y-0.5"
    >
        Login
    </button>

</form>

<p class="text-center text-stone-300 text-sm mt-8">

    Don't have an account?

    <a
        href="/auth/register"
        class="text-teal-600 hover:text-teal-700 font-bold ml-1 transition-colors"
    >
        Create one
    </a>

</p>

        </div>

    </main>

    <%- include("../partials/footer") %>
    
    <style>
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animate-blob {
            animation: blob 7s infinite;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        .animation-delay-4000 {
            animation-delay: 4s;
        }
    </style>
</body>

</html>