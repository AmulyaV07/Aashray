<!DOCTYPE html>
<html lang="en">

<head>

    <title>My Complaints</title>

    <%- include("../partials/head") %>

</head>

<body class="bg-slate-950 text-white">

    <%- include("../partials/navbar") %>

    <main class="max-w-5xl mx-auto py-10 px-6">

        <h1 class="text-3xl font-bold mb-8">
            My Complaints
        </h1>

        <% complaints.forEach((complaint) => { %>

            <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 mb-5">

                <a
                    href="/complaints/<%= complaint._id %>"
                    class="text-xl font-semibold hover:text-blue-400"
                >
                    <%= complaint.title %>
                </a>

                <p class="text-slate-400 mt-2">
                    <%= complaint.description %>
                </p>

                <div class="flex justify-between mt-5">

                    <span>
                        <%= complaint.category %>
                    </span>

                    <span class="text-blue-400">
                        <%= complaint.status %>
                    </span>

                </div>

                <% if (complaint.status === "Pending") { %>

                    <div class="flex gap-3 mt-5">

                        <a
                            href="/complaints/<%= complaint._id %>/edit"
                            class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg"
                        >
                            Edit
                        </a>

                        <form
                            action="/complaints/<%= complaint._id %>/delete"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg"
                            >
                                Cancel
                            </button>

                        </form>

                    </div>

                <% } %>

            </div>

        <% }) %>

    </main>

    <%- include("../partials/footer") %>

</body>

</html>