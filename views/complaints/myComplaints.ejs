<!DOCTYPE html>
<html lang="en">

<head>

    <title>My Complaints | AASHRAY</title>

    <%- include("../partials/head") %>

</head>

<body class="bg-stone-900 text-stone-200 font-[Inter] antialiased selection:bg-teal-100 selection:text-teal-900">

    <%- include("../partials/navbar") %>

    <main class="max-w-5xl mx-auto py-12 px-6 lg:px-8">

        <h1 class="text-3xl font-extrabold text-stone-100 tracking-tight mb-8">
            My Complaints
        </h1>

        <div class="space-y-6">
        <% complaints.forEach((complaint) => { %>

            <div class="bg-stone-900 border border-stone-800 rounded-[1.5rem] p-6 shadow-sm hover:shadow-md transition-shadow">

                <a
                    href="/complaints/<%= complaint._id %>"
                    class="text-xl font-bold text-stone-200 hover:text-teal-600 transition-colors"
                >
                    <%= complaint.title %>
                </a>

                <p class="text-stone-300 mt-3 line-clamp-2">
                    <%= complaint.description %>
                </p>

                <div class="flex flex-wrap gap-4 items-center mt-5">

                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-900 text-xs font-semibold text-stone-200 border border-stone-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>
                        <%= complaint.category %>
                    </span>

                    <% if(complaint.status === 'Pending') { %>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-600 border border-amber-100">
                            <%= complaint.status %>
                        </span>
                    <% } else if(complaint.status === 'In Progress') { %>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-600 border border-blue-100">
                            <%= complaint.status %>
                        </span>
                    <% } else { %>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600 border border-emerald-100">
                            <%= complaint.status %>
                        </span>
                    <% } %>

                </div>

                <% if (complaint.status === "Pending") { %>

                    <div class="flex gap-3 mt-6 pt-5 border-t border-stone-800">

                        <a
                            href="/complaints/<%= complaint._id %>/edit"
                            class="bg-stone-900 hover:bg-stone-200 text-stone-200 px-5 py-2.5 rounded-xl text-sm font-bold transition-colors"
                        >
                            Edit
                        </a>

                        <form
                            action="/complaints/<%= complaint._id %>/delete"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-5 py-2.5 rounded-xl text-sm font-bold transition-colors shadow-sm"
                            >
                                Cancel Complaint
                            </button>

                        </form>

                    </div>

                <% } %>

            </div>

        <% }) %>
        </div>

    </main>

    <%- include("../partials/footer") %>

</body>

</html>