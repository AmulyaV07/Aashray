<!DOCTYPE html>
<html lang="en">

<head>

    <title>Edit Complaint | AASHRAY</title>

    <%- include("../partials/head") %>

</head>

<body class="bg-stone-900 text-stone-200 font-[Inter] antialiased selection:bg-teal-100 selection:text-teal-900">

    <%- include("../partials/navbar") %>

    <main class="max-w-3xl mx-auto py-12 px-6 lg:px-8">

        <div class="bg-stone-900 rounded-[2rem] border border-stone-800 shadow-sm p-8 sm:p-10 relative overflow-hidden">
            
            <div class="absolute top-0 left-0 w-48 h-48 bg-amber-50 rounded-full blur-3xl opacity-60 -translate-y-1/2 -translate-x-1/2"></div>

            <div class="relative z-10">
                <h1 class="text-3xl font-extrabold text-stone-100 tracking-tight">
                    Edit Complaint
                </h1>

                <p class="text-stone-300 mt-2 mb-10">
                    Update the details of your complaint below.
                </p>

                <form action="/complaints/<%= complaint._id %>/edit" method="POST" class="space-y-6">

                    <div>
                        <label class="block mb-2 text-sm font-semibold text-stone-200">
                            Complaint Title
                        </label>
                        <input
                            type="text"
                            name="title"
                            value="<%= complaint.title %>"
                            class="w-full rounded-xl bg-stone-900 border border-stone-800 px-4 py-3.5 text-stone-200 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200"
                            required
                        >
                    </div>

                    <div>
                        <label class="block mb-2 text-sm font-semibold text-stone-200">
                            Category
                        </label>
                        <select
                            name="category"
                            class="w-full rounded-xl bg-stone-900 border border-stone-800 px-4 py-3.5 text-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200 cursor-pointer appearance-none"
                            required
                        >
                            <option <%= complaint.category === 'Water' ? 'selected' : '' %>>Water</option>
                            <option <%= complaint.category === 'Electricity' ? 'selected' : '' %>>Electricity</option>
                            <option <%= complaint.category === 'Cleaning' ? 'selected' : '' %>>Cleaning</option>
                            <option <%= complaint.category === 'Internet' ? 'selected' : '' %>>Internet</option>
                            <option <%= complaint.category === 'Furniture' ? 'selected' : '' %>>Furniture</option>
                        </select>
                    </div>

                    <div>
                        <label class="block mb-2 text-sm font-semibold text-stone-200">
                            Description
                        </label>
                        <textarea
                            name="description"
                            rows="5"
                            class="w-full rounded-xl bg-stone-900 border border-stone-800 px-4 py-3.5 text-stone-200 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200 resize-y"
                            required
                        ><%= complaint.description %></textarea>
                    </div>

                    <div>
                        <label class="block mb-2 text-sm font-semibold text-stone-200">
                            Room Number
                        </label>
                        <input
                            type="text"
                            name="roomNumber"
                            value="<%= complaint.roomNumber %>"
                            class="w-full rounded-xl bg-stone-900 border border-stone-800 px-4 py-3.5 text-stone-200 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200"
                            required
                        >
                    </div>

                    <div class="flex gap-4 pt-4">
                        <a 
                            href="/complaints/<%= complaint._id %>"
                            class="flex-1 text-center bg-stone-900 hover:bg-stone-200 text-stone-200 rounded-xl py-4 font-bold transition-all duration-300"
                        >
                            Cancel
                        </a>
                        <button
                            type="submit"
                            class="flex-1 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-4 font-bold transition-all duration-300 shadow-lg shadow-teal-600/20 hover:shadow-teal-600/40 hover:-translate-y-0.5"
                        >
                            Save Changes
                        </button>
                    </div>

                </form>
            </div>

        </div>

    </main>

    <%- include("../partials/footer") %>

</body>

</html>