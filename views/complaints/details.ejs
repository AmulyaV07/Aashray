<!DOCTYPE html>
<html lang="en">

<head>

    <title>Complaint Details | AASHRAY</title>

    <%- include("../partials/head") %>

</head>


<body class="bg-stone-900 text-stone-200 font-[Inter] min-h-screen antialiased selection:bg-teal-100 selection:text-teal-900">

    <%- include("../partials/navbar") %>


    <main class="max-w-3xl mx-auto py-12 px-6 lg:px-8">


        <!-- Complaint Details -->

        <div class="bg-stone-900 border border-stone-800 rounded-[2rem] p-8 sm:p-10 shadow-sm relative overflow-hidden">
            
            <div class="absolute top-0 right-0 w-64 h-64 bg-stone-900 rounded-full blur-3xl opacity-60 -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

            <div class="relative z-10">

                <!-- Header -->

                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">

                    <div>

                        <p class="text-teal-600 text-xs font-bold tracking-widest mb-3 uppercase">
                            Complaint Details
                        </p>

                        <h1 class="text-3xl font-extrabold text-stone-100 leading-tight">
                            <%= complaint.title %>
                        </h1>

                    </div>


                    <!-- Status -->

                    <% if (complaint.status === "Pending") { %>

                        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-amber-50 text-amber-600 border border-amber-100 shadow-sm">
                            <span class="w-2 h-2 rounded-full bg-amber-500 mr-2 animate-pulse"></span>
                            Pending
                        </span>


                    <% } else if (complaint.status === "In Progress") { %>

                        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-blue-50 text-blue-600 border border-blue-100 shadow-sm">
                            <span class="w-2 h-2 rounded-full bg-blue-500 mr-2 animate-pulse"></span>
                            In Progress
                        </span>


                    <% } else if (complaint.status === "Resolved") { %>

                        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-emerald-50 text-emerald-600 border border-emerald-100 shadow-sm">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2"></span>
                            Resolved
                        </span>


                    <% } else { %>

                        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-stone-900 text-stone-200 border border-stone-800 shadow-sm">
                            <%= complaint.status %>
                        </span>

                    <% } %>


                </div>


                <!-- Description -->

                <div class="mt-8">

                    <p class="text-xs text-stone-300 font-bold uppercase tracking-widest">
                        Description
                    </p>

                    <p class="text-stone-200 mt-3 leading-relaxed text-lg bg-stone-900 rounded-xl p-5 border border-stone-800">
                        <%= complaint.description %>
                    </p>

                </div>


                <!-- Complaint Information -->

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-8">


                    <div class="bg-stone-900 border border-stone-800 shadow-sm rounded-xl p-5 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-teal-50 flex items-center justify-center text-teal-600 text-xl">
                            🏷️
                        </div>
                        <div>
                            <p class="text-xs text-stone-300 font-bold uppercase tracking-widest">
                                Category
                            </p>

                            <p class="text-stone-200 font-semibold mt-1">
                                <%= complaint.category %>
                            </p>
                        </div>
                    </div>


                    <div class="bg-stone-900 border border-stone-800 shadow-sm rounded-xl p-5 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-purple-50 flex items-center justify-center text-purple-600 text-xl">
                            🚪
                        </div>
                        <div>
                            <p class="text-xs text-stone-300 font-bold uppercase tracking-widest">
                                Room
                            </p>

                            <p class="text-stone-200 font-semibold mt-1">
                                <%= complaint.roomNumber %>
                            </p>
                        </div>
                    </div>


                </div>


                <!-- Timeline -->

                <div class="mt-12 pt-10 border-t border-stone-800">

                    <h2 class="text-2xl font-bold text-stone-100">
                        Complaint Timeline
                    </h2>

                    <p class="text-stone-300 text-sm mt-2">
                        Track the progress of your complaint in real-time.
                    </p>


                    <div class="mt-8 relative ml-3 space-y-8 before:absolute before:inset-0 before:ml-[5px] before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-stone-200 before:to-transparent">


                        <!-- Complaint Raised -->

                        <div class="relative flex items-start gap-6">

                            <div class="absolute left-0 w-3 h-3 rounded-full bg-teal-500 ring-4 ring-white shadow-sm mt-1.5 -ml-1"></div>

                            <div class="ml-8 bg-stone-900 border border-stone-800 p-4 rounded-xl shadow-sm w-full">

                                <p class="font-bold text-stone-200">
                                    Complaint Raised
                                </p>

                                <% if (complaint.createdAt) { %>

                                    <p class="text-sm text-stone-300 mt-1 flex items-center gap-1.5">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <%= new Date(complaint.createdAt).toLocaleString("en-IN", {
    timeZone: "Asia/Kolkata",
    dateStyle: "short",
    timeStyle: "short"
}) %>
                                    </p>

                                <% } %>

                            </div>

                        </div>


                        <!-- Assigned -->

                        <div class="relative flex items-start gap-6 opacity-<%= complaint.assignedAt ? '100' : '50' %>">

                            <div class="absolute left-0 w-3 h-3 rounded-full <%= complaint.assignedAt ? 'bg-purple-500' : 'bg-stone-300' %> ring-4 ring-white shadow-sm mt-1.5 -ml-1"></div>

                            <div class="ml-8 bg-stone-900 border border-stone-800 p-4 rounded-xl shadow-sm w-full">

                                <p class="font-bold text-stone-200">
                                    Worker Assigned
                                </p>

                                <% if (complaint.assignedAt) { %>

                                    <p class="text-sm text-stone-300 mt-1 flex items-center gap-1.5">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <%=new Date(complaint.assignedAt).toLocaleString("en-IN", {
    timeZone: "Asia/Kolkata",
    dateStyle: "short",
    timeStyle: "short"
})%>
                                    </p>

                                <% } else { %>

                                    <p class="text-sm text-stone-300 mt-1 italic">
                                        Waiting for assignment
                                    </p>

                                <% } %>

                            </div>

                        </div>


                        <!-- Started -->

                        <div class="relative flex items-start gap-6 opacity-<%= complaint.startedAt ? '100' : '50' %>">

                            <div class="absolute left-0 w-3 h-3 rounded-full <%= complaint.startedAt ? 'bg-amber-500' : 'bg-stone-300' %> ring-4 ring-white shadow-sm mt-1.5 -ml-1"></div>

                            <div class="ml-8 bg-stone-900 border border-stone-800 p-4 rounded-xl shadow-sm w-full">

                                <p class="font-bold text-stone-200">
                                    Task Started
                                </p>

                                <% if (complaint.startedAt) { %>

                                    <p class="text-sm text-stone-300 mt-1 flex items-center gap-1.5">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <%=new Date(complaint.startedAt).toLocaleString("en-IN", {
    timeZone: "Asia/Kolkata",
    dateStyle: "short",
    timeStyle: "short"
})%>
                                    </p>

                                <% } else { %>

                                    <p class="text-sm text-stone-300 mt-1 italic">
                                        Not started yet
                                    </p>

                                <% } %>

                            </div>

                        </div>


                        <!-- Resolved -->

                        <div class="relative flex items-start gap-6 opacity-<%= complaint.resolvedAt ? '100' : '50' %>">

                            <div class="absolute left-0 w-3 h-3 rounded-full <%= complaint.resolvedAt ? 'bg-emerald-500' : 'bg-stone-300' %> ring-4 ring-white shadow-sm mt-1.5 -ml-1"></div>

                            <div class="ml-8 bg-stone-900 border border-stone-800 p-4 rounded-xl shadow-sm w-full">

                                <p class="font-bold text-stone-200">
                                    Complaint Resolved
                                </p>

                                <% if (complaint.resolvedAt) { %>

                                    <p class="text-sm text-stone-300 mt-1 flex items-center gap-1.5">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <%=new Date(complaint.resolvedAt).toLocaleString("en-IN", {
    timeZone: "Asia/Kolkata",
    dateStyle: "short",
    timeStyle: "short"
})%>
                                    </p>

                                <% } else { %>

                                    <p class="text-sm text-stone-300 mt-1 italic">
                                        Not resolved yet
                                    </p>

                                <% } %>

                            </div>

                        </div>


                    </div>

                    <% if (complaint.status === "Resolved") { %>
                        <div class="mt-12 flex justify-center">
                            <a href="/feedback/<%= complaint._id %>" class="inline-flex items-center gap-2 bg-gradient-to-r from-teal-600 to-emerald-500 hover:from-teal-500 hover:to-emerald-400 text-white px-8 py-3.5 rounded-xl font-bold shadow-lg shadow-teal-500/25 hover:shadow-teal-500/40 hover:-translate-y-0.5 transition-all duration-300">
                                ⭐ Provide Feedback
                            </a>
                        </div>
                    <% } %>

                </div>

            </div>

        </div>


    </main>


    <%- include("../partials/footer") %>


</body>

</html>