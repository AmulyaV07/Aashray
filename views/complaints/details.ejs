<!DOCTYPE html>
<html lang="en">

<head>

    <title>Complaint Details</title>

    <%- include("../partials/head") %>

</head>


<body class="bg-slate-950 text-white min-h-screen">

    <%- include("../partials/navbar") %>


    <main class="max-w-3xl mx-auto py-10 px-6">


        <!-- Complaint Details -->

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">


            <!-- Header -->

            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">

                <div>

                    <p class="text-blue-400 text-sm font-medium mb-2">
                        COMPLAINT DETAILS
                    </p>

                    <h1 class="text-3xl font-bold">
                        <%= complaint.title %>
                    </h1>

                </div>


                <!-- Status -->

                <% if (complaint.status === "Pending") { %>

                    <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">
                        Pending
                    </span>


                <% } else if (complaint.status === "In Progress") { %>

                    <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
                        In Progress
                    </span>


                <% } else if (complaint.status === "Resolved") { %>

                    <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20">
                        Resolved
                    </span>


                <% } else { %>

                    <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-slate-800 text-slate-300">
                        <%= complaint.status %>
                    </span>

                <% } %>


            </div>


            <!-- Description -->

            <div class="mt-8">

                <p class="text-xs text-slate-500 uppercase tracking-wide">
                    Description
                </p>

                <p class="text-slate-400 mt-2 leading-relaxed">
                    <%= complaint.description %>
                </p>

            </div>


            <!-- Complaint Information -->

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-8">


                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                    <p class="text-xs text-slate-500 uppercase tracking-wide">
                        Category
                    </p>

                    <p class="text-slate-200 mt-1">
                        <%= complaint.category %>
                    </p>

                </div>


                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                    <p class="text-xs text-slate-500 uppercase tracking-wide">
                        Room
                    </p>

                    <p class="text-slate-200 mt-1">
                        <%= complaint.roomNumber %>
                    </p>

                </div>


            </div>


            <!-- Timeline -->

            <div class="mt-10 pt-8 border-t border-slate-800">

                <h2 class="text-xl font-semibold">
                    Complaint Timeline
                </h2>

                <p class="text-slate-500 text-sm mt-1">
                    Track the progress of your complaint.
                </p>


                <div class="mt-6 space-y-6">


                    <!-- Complaint Raised -->

                    <div class="flex gap-4">

                        <div class="w-3 h-3 rounded-full bg-blue-500 mt-1.5 shrink-0"></div>

                        <div>

                            <p class="font-medium">
                                Complaint Raised
                            </p>

                            <% if (complaint.createdAt) { %>

                                <p class="text-sm text-slate-400 mt-1">
                                    <%= new Date(complaint.createdAt).toLocaleString("en-IN") %>
                                </p>

                            <% } %>

                        </div>

                    </div>


                    <!-- Assigned -->

                    <div class="flex gap-4">

                        <div class="w-3 h-3 rounded-full bg-purple-500 mt-1.5 shrink-0"></div>

                        <div>

                            <p class="font-medium">
                                Worker Assigned
                            </p>

                            <% if (complaint.assignedAt) { %>

                                <p class="text-sm text-slate-400 mt-1">
                                    <%= new Date(complaint.assignedAt).toLocaleString("en-IN") %>
                                </p>

                            <% } else { %>

                                <p class="text-sm text-slate-500 mt-1">
                                    Waiting for assignment
                                </p>

                            <% } %>

                        </div>

                    </div>


                    <!-- Started -->

                    <div class="flex gap-4">

                        <div class="w-3 h-3 rounded-full bg-yellow-500 mt-1.5 shrink-0"></div>

                        <div>

                            <p class="font-medium">
                                Task Started
                            </p>

                            <% if (complaint.startedAt) { %>

                                <p class="text-sm text-slate-400 mt-1">
                                    <%= new Date(complaint.startedAt).toLocaleString("en-IN") %>
                                </p>

                            <% } else { %>

                                <p class="text-sm text-slate-500 mt-1">
                                    Not started yet
                                </p>

                            <% } %>

                        </div>

                    </div>


                    <!-- Resolved -->

                    <div class="flex gap-4">

                        <div class="w-3 h-3 rounded-full bg-green-500 mt-1.5 shrink-0"></div>

                        <div>

                            <p class="font-medium">
                                Complaint Resolved
                            </p>

                            <% if (complaint.resolvedAt) { %>

                                <p class="text-sm text-slate-400 mt-1">
                                    <%= new Date(complaint.resolvedAt).toLocaleString("en-IN") %>
                                </p>

                            <% } else { %>

                                <p class="text-sm text-slate-500 mt-1">
                                    Not resolved yet
                                </p>

                            <% } %>

                        </div>

                    </div>


                </div>

            </div>


        </div>


    </main>


    <%- include("../partials/footer") %>


</body>

</html>