<!DOCTYPE html>
<html lang="en">

<head>

    <title>Give Feedback | AASHRAY</title>

    <%- include("../partials/head") %>

</head>

<body class="bg-stone-900 text-stone-200 font-[Inter] min-h-screen antialiased selection:bg-teal-100 selection:text-teal-900">

    <%- include("../partials/navbar") %>


    <main class="max-w-3xl mx-auto py-12 px-6 lg:px-8">


        <div class="mb-10 text-center">

            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 border border-teal-100 mb-4">
                <span class="w-2 h-2 rounded-full bg-teal-500"></span>
                <p class="text-teal-700 text-xs font-bold tracking-widest uppercase">
                    Aashray Feedback
                </p>
            </div>

            <h1 class="text-4xl font-extrabold text-stone-100 tracking-tight">
                Rate Your Experience
            </h1>

            <p class="text-stone-300 mt-3 text-lg">
                Your complaint has been resolved. Let us know how we did.
            </p>

        </div>


        <div class="bg-stone-900 border border-stone-800 rounded-[2rem] p-8 sm:p-10 shadow-sm relative overflow-hidden">
            
            <div class="absolute top-0 right-0 w-64 h-64 bg-teal-50/50 rounded-full blur-3xl opacity-60 -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

            <div class="relative z-10">

                <div class="bg-stone-900 border border-stone-800 rounded-xl p-5 mb-8">
                    <p class="text-xs text-stone-300 font-bold uppercase tracking-widest mb-1">
                        Resolved Issue
                    </p>
                    <h2 class="text-lg font-bold text-stone-200">
                        <%= complaint.title %>
                    </h2>
                    <p class="text-stone-300 text-sm mt-1 line-clamp-2">
                        <%= complaint.description %>
                    </p>
                </div>


                <form
                    action="/feedback/<%= complaint._id %>"
                    method="POST"
                >

                    <!-- Rating -->

                    <div class="mb-6">

                        <label class="block text-sm font-bold text-stone-200 mb-3">
                            How would you rate the resolution? <span class="text-red-500">*</span>
                        </label>

                        <div class="relative">
                            <select
                                name="rating"
                                required
                                class="w-full bg-stone-900 border border-stone-800 text-stone-200 text-sm rounded-xl focus:ring-4 focus:ring-teal-500/20 focus:border-teal-500 block p-3.5 appearance-none font-medium transition-all"
                            >
                                <option value="" disabled selected>Select a rating...</option>
                                <option value="5">⭐⭐⭐⭐⭐ — Excellent</option>
                                <option value="4">⭐⭐⭐⭐ — Good</option>
                                <option value="3">⭐⭐⭐ — Average</option>
                                <option value="2">⭐⭐ — Poor</option>
                                <option value="1">⭐ — Very Poor</option>
                            </select>
                            
                            <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-stone-300">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </div>
                        </div>

                    </div>


                    <!-- Comment -->

                    <div class="mb-8">

                        <label class="block text-sm font-bold text-stone-200 mb-3">
                            Your Feedback
                        </label>

                        <textarea
                            name="comment"
                            rows="4"
                            maxlength="500"
                            placeholder="Tell us about your experience..."
                            class="w-full bg-stone-900 border border-stone-800 text-stone-200 text-sm rounded-xl focus:ring-4 focus:ring-teal-500/20 focus:border-teal-500 block p-3.5 transition-all resize-none placeholder-stone-400"
                        ></textarea>

                    </div>


                    <button
                        type="submit"
                        class="w-full text-white bg-teal-600 hover:bg-teal-700 focus:ring-4 focus:outline-none focus:ring-teal-500/50 font-bold rounded-xl text-sm px-5 py-4 text-center transition-all duration-300 shadow-lg shadow-teal-600/20 hover:shadow-teal-600/40 hover:-translate-y-0.5"
                    >
                        Submit Feedback
                    </button>

                </form>

            </div>
        </div>

    </main>


    <%- include("../partials/footer") %>

</body>

</html>