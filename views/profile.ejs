<!DOCTYPE html>
<html lang="en">

<head>

    <title>Profile | AASHRAY</title>

    <%- include("./partials/head") %>

</head>

<body class="bg-stone-900 text-stone-200 font-[Inter] antialiased selection:bg-teal-100 selection:text-teal-900">

    <%- include("./partials/navbar") %>

    <main class="max-w-3xl mx-auto py-12 px-6 lg:px-8">

        <div class="bg-stone-900 border border-stone-800 rounded-[2rem] p-10 shadow-sm relative overflow-hidden">
            
            <!-- Decorative background elements -->
            <div class="absolute top-0 right-0 w-64 h-64 bg-teal-50 rounded-full blur-3xl opacity-60 -translate-y-1/2 translate-x-1/3"></div>
            <div class="absolute bottom-0 left-0 w-48 h-48 bg-emerald-50 rounded-full blur-2xl opacity-60 translate-y-1/3 -translate-x-1/4"></div>

            <div class="relative z-10 flex flex-col md:flex-row gap-10 items-start md:items-center">
                
                <div class="w-32 h-32 rounded-[1.5rem] bg-stone-900 flex items-center justify-center text-4xl shadow-inner border border-stone-800 text-stone-300">
                    👤
                </div>

                <div class="flex-1">
                    <h1 class="text-3xl font-extrabold text-stone-100 tracking-tight mb-8">
                        My Profile
                    </h1>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                        <div class="bg-stone-900 border border-stone-800 rounded-xl p-4">
                            <p class="text-sm font-semibold text-teal-600 mb-1">Name</p>
                            <h2 class="text-lg font-bold text-stone-200"><%= user.name %></h2>
                        </div>

                        <div class="bg-stone-900 border border-stone-800 rounded-xl p-4">
                            <p class="text-sm font-semibold text-teal-600 mb-1">Email</p>
                            <h2 class="text-lg font-bold text-stone-200"><%= user.email %></h2>
                        </div>

                        <div class="bg-stone-900 border border-stone-800 rounded-xl p-4 sm:col-span-2">
                            <p class="text-sm font-semibold text-teal-600 mb-1">Room Number</p>
                            <h2 class="text-lg font-bold text-stone-200"><%= user.roomNumber %></h2>
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </main>

    <%- include("./partials/footer") %>

</body>

</html>