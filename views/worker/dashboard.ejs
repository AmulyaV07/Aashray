<!DOCTYPE html>
<html lang="en">

<head>

    <title>Worker Dashboard | AASHRAY</title>

    <%- include("../partials/head") %>

</head>


<body class="bg-stone-900 text-stone-200 font-[Inter] min-h-screen antialiased selection:bg-teal-100 selection:text-teal-900">

    <%- include("../partials/navbar") %>


    <main class="max-w-7xl mx-auto py-12 px-6 lg:px-8">


        <!-- Header -->

        <div class="mb-12">

            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-50 text-teal-600 text-xs font-bold tracking-widest mb-3 uppercase border border-teal-100 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
                Workforce
            </div>

            <h1 class="text-4xl font-extrabold tracking-tight text-stone-100">
                Worker Dashboard
            </h1>

            <p class="text-stone-300 mt-2 text-lg">
                Manage and resolve the complaints assigned to you.
            </p>

        </div>


        <!-- Stats -->

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">


            <!-- Assigned -->

            <div class="bg-stone-900 border border-stone-800 rounded-[1.5rem] p-6 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-stone-900 rounded-full group-hover:scale-110 transition-transform duration-500"></div>
                
                <p class="text-stone-300 text-sm font-bold uppercase tracking-widest relative z-10">
                    Assigned Tasks
                </p>

                <p class="text-5xl font-extrabold mt-3 text-stone-100 relative z-10">
                    <%= tasks.length %>
                </p>

            </div>


            <!-- Pending -->

            <div class="bg-stone-900 border border-stone-800 rounded-[1.5rem] p-6 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-amber-50 rounded-full group-hover:scale-110 transition-transform duration-500"></div>
                
                <p class="text-stone-300 text-sm font-bold uppercase tracking-widest relative z-10">
                    Pending
                </p>

                <p class="text-5xl font-extrabold mt-3 text-stone-100 relative z-10">
                    <%= tasks.filter(task => task.status === "Pending").length %>
                </p>

            </div>


            <!-- In Progress -->

            <div class="bg-stone-900 border border-stone-800 rounded-[1.5rem] p-6 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-blue-50 rounded-full group-hover:scale-110 transition-transform duration-500"></div>
                
                <p class="text-stone-300 text-sm font-bold uppercase tracking-widest relative z-10">
                    In Progress
                </p>

                <p class="text-5xl font-extrabold mt-3 text-stone-100 relative z-10">
                    <%= tasks.filter(task => task.status === "In Progress").length %>
                </p>

            </div>

        </div>


        <!-- Tasks -->

        <div>


            <div class="mb-8">

                <h2 class="text-2xl font-bold text-stone-100">
                    Assigned Complaints
                </h2>

                <p class="text-stone-300 mt-1">
                    Complaints that require your attention.
                </p>

            </div>


            <% if (tasks.length === 0) { %>


                <div class="bg-stone-900 border border-stone-800 rounded-[2rem] p-12 text-center shadow-sm">
                    <div class="w-20 h-20 bg-stone-900 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl">
                        🎉
                    </div>
                    <h3 class="text-xl font-bold text-stone-200">
                        No tasks assigned
                    </h3>

                    <p class="text-stone-300 mt-2">
                        You have caught up with all your work! Take a break.
                    </p>

                </div>


            <% } else { %>


                <div class="space-y-6">


                    <% tasks.forEach((task) => { %>


                        <div class="bg-stone-900 border border-stone-800 rounded-[2rem] p-8 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-32 h-32 bg-stone-900 rounded-full blur-3xl opacity-60 -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>

                            <div class="flex flex-col lg:flex-row lg:justify-between gap-8 relative z-10">


                                <!-- Complaint Information -->

                                <div class="flex-1">


                                    <div class="flex flex-wrap items-center gap-4 mb-3">

                                        <h3 class="text-2xl font-extrabold text-stone-100">
                                            <%= task.title %>
                                        </h3>


                                        <span class="text-xs font-bold px-3 py-1 rounded-full bg-stone-900 text-stone-200 border border-stone-800 uppercase tracking-wide">
                                            <%= task.category %>
                                        </span>

                                    </div>


                                    <p class="text-stone-300 mt-2 text-lg leading-relaxed max-w-3xl">
                                        <%= task.description %>
                                    </p>


                                    <% if (task.user) { %>

                                        <p class="text-sm font-semibold text-stone-300 mt-5">

                                            Raised by

                                            <span class="text-stone-200">
                                                <%= task.user.name %>
                                            </span>

                                            <% if (task.user.roomNumber) { %>
                                                <span class="text-stone-300 mx-2">•</span>
                                                Room <span class="text-stone-200"><%= task.user.roomNumber %></span>
                                            <% } %>

                                        </p>

                                    <% } %>


                                    <!-- Timeline -->

                                    <div class="mt-8 pt-6 border-t border-stone-800">


                                        <p class="text-xs text-stone-300 font-bold uppercase tracking-widest mb-6">
                                            Task Timeline
                                        </p>


                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">


                                            <!-- Assigned -->

                                            <div class="bg-stone-900 border border-stone-800 rounded-xl p-5 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.05)]">

                                                <p class="text-sm font-bold text-stone-200">
                                                    Assigned
                                                </p>

                                                <% if (task.assignedAt) { %>

                                                    <p class="text-xs font-medium text-stone-300 mt-2">
                                                        <%= new Date(task.assignedAt).toLocaleString("en-IN") %>
                                                    </p>

                                                <% } else { %>

                                                    <p class="text-xs text-stone-300 mt-2 italic">
                                                        Not available
                                                    </p>

                                                <% } %>

                                            </div>


                                            <!-- Started -->

                                            <div class="bg-stone-900 border border-stone-800 rounded-xl p-5 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.05)] opacity-<%= task.startedAt ? '100' : '60' %>">

                                                <p class="text-sm font-bold text-stone-200">
                                                    Started
                                                </p>

                                                <% if (task.startedAt) { %>

                                                    <p class="text-xs font-medium text-stone-300 mt-2">
                                                        <%= new Date(task.startedAt).toLocaleString("en-IN") %>
                                                    </p>

                                                <% } else { %>

                                                    <p class="text-xs text-stone-300 mt-2 italic">
                                                        Not started
                                                    </p>

                                                <% } %>

                                            </div>


                                            <!-- Resolved -->

                                            <div class="bg-stone-900 border border-stone-800 rounded-xl p-5 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.05)] opacity-<%= task.resolvedAt ? '100' : '60' %>">

                                                <p class="text-sm font-bold text-stone-200">
                                                    Resolved
                                                </p>

                                                <% if (task.resolvedAt) { %>

                                                    <p class="text-xs font-medium text-stone-300 mt-2">
                                                        <%= new Date(task.resolvedAt).toLocaleString("en-IN") %>
                                                    </p>

                                                <% } else { %>

                                                    <p class="text-xs text-stone-300 mt-2 italic">
                                                        Not resolved
                                                    </p>

                                                <% } %>

                                            </div>


                                        </div>

                                    </div>


                                </div>


                                <!-- Status + Action -->

                                <div class="flex flex-col items-start lg:items-end gap-5 shrink-0">


                                    <% if (task.status === "Pending") { %>


                                        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-amber-50 text-amber-600 border border-amber-100 shadow-sm">
                                            <span class="w-2 h-2 rounded-full bg-amber-500 mr-2 animate-pulse"></span>
                                            Pending
                                        </span>


                                        <form
                                            action="/complaints/<%= task._id %>/start"
                                            method="POST"
                                            class="w-full lg:w-auto mt-4"
                                        >

                                            <button
                                                type="submit"
                                                class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-all duration-300 shadow-lg shadow-blue-600/20 hover:shadow-blue-600/40 hover:-translate-y-0.5 whitespace-nowrap"
                                            >
                                                Start Task
                                            </button>

                                        </form>


                                    <% } else if (task.status === "In Progress") { %>


                                        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-blue-50 text-blue-600 border border-blue-100 shadow-sm">
                                            <span class="w-2 h-2 rounded-full bg-blue-500 mr-2 animate-pulse"></span>
                                            In Progress
                                        </span>


                                        <form
                                            action="/complaints/<%= task._id %>/complete"
                                            method="POST"
                                            class="w-full lg:w-auto mt-4"
                                        >

                                            <button
                                                type="submit"
                                                class="w-full px-6 py-3 bg-teal-600 hover:bg-teal-700 text-white rounded-xl font-bold transition-all duration-300 shadow-lg shadow-teal-600/20 hover:shadow-teal-600/40 hover:-translate-y-0.5 whitespace-nowrap"
                                            >
                                                Complete Task
                                            </button>

                                        </form>


                                    <% } else { %>


                                        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-bold bg-emerald-50 text-emerald-600 border border-emerald-100 shadow-sm">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2"></span>
                                            <%= task.status %>
                                        </span>


                                    <% } %>


                                </div>


                            </div>


                        </div>


                    <% }) %>


                </div>


            <% } %>


        </div>


    </main>


    <%- include("../partials/footer") %>


</body>

</html>