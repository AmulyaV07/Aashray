<!DOCTYPE html>
<html lang="en">

<head>

    <title>Worker Management</title>

    <%- include("../partials/head") %>

</head>


<body class="bg-slate-950 text-white min-h-screen">

    <%- include("../partials/navbar") %>


    <main class="max-w-7xl mx-auto py-10 px-6">


        <!-- Header -->

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-10">

            <div>

                <p class="text-blue-400 font-medium mb-2">
                    AASHRAY ADMIN
                </p>

                <h1 class="text-4xl font-bold">
                    Worker Management
                </h1>

                <p class="text-slate-400 mt-2">
                    Monitor workers and their current workload.
                </p>

            </div>


            <a
                href="/admin/workers/add"
                class="inline-flex items-center justify-center px-5 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition"
            >
                + Add Worker
            </a>

        </div>


        <!-- Worker Count -->

        <div class="bg-slate-900 border border-slate-800 rounded-2xl px-6 py-5 mb-6">

            <p class="text-sm text-slate-400">
                Total Workers
            </p>

            <p class="text-3xl font-bold mt-1">
                <%= workers.length %>
            </p>

        </div>


        <% if (workers.length === 0) { %>


            <!-- No Workers -->

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-10 text-center">

                <div class="text-4xl mb-4">
                    👷
                </div>

                <h2 class="text-xl font-semibold">
                    No Workers Found
                </h2>

                <p class="text-slate-400 mt-2">
                    Create a worker to start assigning complaints.
                </p>

                <a
                    href="/admin/workers/add"
                    class="inline-block mt-6 px-5 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition"
                >
                    Create Worker
                </a>

            </div>


        <% } else { %>


            <!-- Workers -->

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">


                <% workers.forEach((worker) => { %>


                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 hover:border-slate-700 transition">


                        <!-- Worker Header -->

                        <div class="flex items-start justify-between gap-4">

                            <div>

                                <div class="flex items-center gap-3">

                                    <h2 class="text-xl font-semibold">
                                        <%= worker.name %>
                                    </h2>


                                    <% if (worker.isActive !== false) { %>

                                        <span class="inline-flex px-2.5 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-xs text-green-400">
                                            Active
                                        </span>

                                    <% } else { %>

                                        <span class="inline-flex px-2.5 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-xs text-red-400">
                                            Deactivated
                                        </span>

                                    <% } %>

                                </div>


                                <p class="text-slate-500 text-sm mt-1">
                                    <%= worker.email %>
                                </p>

                            </div>


                            <div class="w-11 h-11 rounded-full bg-blue-500/10 flex items-center justify-center text-blue-400 font-semibold">

                                <%= worker.name.charAt(0).toUpperCase() %>

                            </div>

                        </div>


                        <!-- Department -->

                        <div class="mt-6">

                            <p class="text-xs text-slate-500 uppercase tracking-wide">
                                Department
                            </p>

                            <span class="inline-flex mt-2 px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-sm">
                                <%= worker.department || "Not assigned" %>
                            </span>

                        </div>


                        <!-- Task Statistics -->

                        <div class="grid grid-cols-3 gap-3 mt-6">


                            <!-- Active -->

                            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                                <p class="text-xs text-slate-500">
                                    ACTIVE
                                </p>

                                <p class="text-2xl font-bold mt-1">
                                    <%= worker.activeTasks %>
                                </p>

                            </div>


                            <!-- Resolved -->

                            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                                <p class="text-xs text-slate-500">
                                    RESOLVED
                                </p>

                                <p class="text-2xl font-bold mt-1">
                                    <%= worker.resolvedTasks %>
                                </p>

                            </div>


                            <!-- Total -->

                            <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                                <p class="text-xs text-slate-500">
                                    TOTAL
                                </p>

                                <p class="text-2xl font-bold mt-1">
                                    <%= worker.totalTasks %>
                                </p>

                            </div>


                        </div>


                        <!-- Workload -->

                        <div class="mt-6 pt-5 border-t border-slate-800">


                            <% if (worker.activeTasks === 0) { %>

                                <div class="flex items-center justify-between">

                                    <p class="text-sm text-slate-400">
                                        Current workload
                                    </p>

                                    <span class="inline-flex px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-sm text-green-400">
                                        Available
                                    </span>

                                </div>


                            <% } else if (worker.activeTasks <= 3) { %>

                                <div class="flex items-center justify-between">

                                    <p class="text-sm text-slate-400">
                                        Current workload
                                    </p>

                                    <span class="inline-flex px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-sm text-green-400">
                                        Light
                                    </span>

                                </div>


                            <% } else if (worker.activeTasks <= 6) { %>

                                <div class="flex items-center justify-between">

                                    <p class="text-sm text-slate-400">
                                        Current workload
                                    </p>

                                    <span class="inline-flex px-3 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/20 text-sm text-yellow-400">
                                        Moderate
                                    </span>

                                </div>


                            <% } else { %>

                                <div class="flex items-center justify-between">

                                    <p class="text-sm text-slate-400">
                                        Current workload
                                    </p>

                                    <span class="inline-flex px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-sm text-red-400">
                                        Heavy
                                    </span>

                                </div>

                            <% } %>


                        </div>


                        <!-- Actions -->

                        <div class="flex gap-3 mt-5">


                            <!-- Edit -->

                            <a
                                href="/admin/workers/<%= worker._id %>/edit"
                                class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-sm font-medium transition"
                            >
                                Edit Worker
                            </a>


                            <!-- Activate / Deactivate -->

                            <form
                                action="/admin/workers/<%= worker._id %>/toggle-status"
                                method="POST"
                                class="flex-1"
                            >

                                <% if (worker.isActive !== false) { %>

                                    <button
                                        type="submit"
                                        onclick="return confirm('Are you sure you want to deactivate this worker?')"
                                        class="w-full px-4 py-2.5 bg-red-600/10 hover:bg-red-600/20 border border-red-500/20 text-red-400 rounded-lg text-sm font-medium transition"
                                    >
                                        Deactivate
                                    </button>

                                <% } else { %>

                                    <button
                                        type="submit"
                                        class="w-full px-4 py-2.5 bg-green-600/10 hover:bg-green-600/20 border border-green-500/20 text-green-400 rounded-lg text-sm font-medium transition"
                                    >
                                        Activate
                                    </button>

                                <% } %>

                            </form>


                        </div>


                    </div>


                <% }) %>


            </div>


        <% } %>


    </main>


    <%- include("../partials/footer") %>


</body>

</html>