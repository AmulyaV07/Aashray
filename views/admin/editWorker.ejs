<!DOCTYPE html>
<html lang="en">

<head>

    <title>Edit Worker</title>

    <%- include("../partials/head") %>

</head>


<body class="bg-slate-950 text-white min-h-screen">

    <%- include("../partials/navbar") %>


    <main class="max-w-2xl mx-auto px-6 py-12">


        <!-- Header -->

        <div class="mb-8">

            <p class="text-blue-400 font-medium mb-2">
                AASHRAY ADMIN
            </p>

            <h1 class="text-3xl font-bold">
                Edit Worker
            </h1>

            <p class="text-slate-400 mt-2">
                Update the worker's information and department.
            </p>

        </div>


        <!-- Form -->

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">


            <form
                action="/admin/workers/<%= worker._id %>/edit"
                method="POST"
                class="space-y-6"
            >


                <!-- Name -->

                <div>

                    <label class="block text-sm text-slate-400 mb-2">
                        Worker Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= worker.name %>"
                        required
                        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white outline-none focus:border-blue-500"
                    >

                </div>


                <!-- Email -->

                <div>

                    <label class="block text-sm text-slate-400 mb-2">
                        Email
                    </label>

                    <input
                        type="email"
                        name="email"
                        value="<%= worker.email %>"
                        required
                        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white outline-none focus:border-blue-500"
                    >

                </div>


                <!-- Department -->

                <div>

                    <label class="block text-sm text-slate-400 mb-2">
                        Department
                    </label>

                    <select
                        name="department"
                        required
                        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-white outline-none focus:border-blue-500"
                    >

                        <option
                            value="Maintenance"
                            <%= worker.department === "Maintenance" ? "selected" : "" %>
                        >
                            Maintenance
                        </option>

                        <option
                            value="Plumbing"
                            <%= worker.department === "Plumbing" ? "selected" : "" %>
                        >
                            Plumbing
                        </option>

                        <option
                            value="Electrical"
                            <%= worker.department === "Electrical" ? "selected" : "" %>
                        >
                            Electrical
                        </option>

                        <option
                            value="Cleaning"
                            <%= worker.department === "Cleaning" ? "selected" : "" %>
                        >
                            Cleaning
                        </option>

                        <option
                            value="Internet"
                            <%= worker.department === "Internet" ? "selected" : "" %>
                        >
                            Internet
                        </option>

                    </select>

                </div>


                <!-- Buttons -->

                <div class="flex gap-3 pt-4">

                    <a
                        href="/admin/workers"
                        class="flex-1 text-center px-5 py-3 bg-slate-800 hover:bg-slate-700 rounded-lg font-medium transition"
                    >
                        Cancel
                    </a>


                    <button
                        type="submit"
                        class="flex-1 px-5 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition"
                    >
                        Save Changes
                    </button>

                </div>


            </form>


        </div>


    </main>


    <%- include("../partials/footer") %>


</body>

</html>