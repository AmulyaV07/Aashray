<!DOCTYPE html>
<html lang="en">

<head>

    <title>Edit Worker | AASHRAY</title>

    <%- include("../partials/head") %>

</head>


<body class="bg-stone-900 text-stone-200 font-[Inter] min-h-screen antialiased selection:bg-teal-100 selection:text-teal-900 flex flex-col">

    <%- include("../partials/navbar") %>


    <main class="flex-grow flex items-center justify-center px-6 py-12 lg:px-8">

        <div class="w-full max-w-2xl bg-stone-900 rounded-[2rem] border border-stone-800 shadow-sm p-8 sm:p-12 relative overflow-hidden">

            <div class="absolute top-0 left-0 w-64 h-64 bg-amber-50 rounded-full blur-3xl opacity-60 -translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

            <div class="relative z-10">

                <!-- Header -->

                <div class="mb-10 text-center">

                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-50 text-teal-600 text-xs font-bold tracking-widest mb-3 uppercase border border-teal-100 shadow-sm">
                        Admin Portal
                    </div>

                    <h1 class="text-3xl font-extrabold text-stone-100 tracking-tight">
                        Edit Worker
                    </h1>

                    <p class="text-stone-300 mt-2 text-lg">
                        Update the worker's information and department.
                    </p>

                </div>


                <!-- Form -->

                <form
                    action="/admin/workers/<%= worker._id %>/edit"
                    method="POST"
                    class="space-y-6"
                >


                    <!-- Name -->

                    <div>

                        <label class="block mb-2 text-sm font-bold text-stone-200">
                            Worker Name
                        </label>

                        <input
                            type="text"
                            name="name"
                            value="<%= worker.name %>"
                            required
                            class="w-full bg-stone-900 border border-stone-800 rounded-xl px-4 py-3.5 text-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200"
                        >

                    </div>


                    <!-- Email -->

                    <div>

                        <label class="block mb-2 text-sm font-bold text-stone-200">
                            Email Address
                        </label>

                        <input
                            type="email"
                            name="email"
                            value="<%= worker.email %>"
                            required
                            class="w-full bg-stone-900 border border-stone-800 rounded-xl px-4 py-3.5 text-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200"
                        >

                    </div>


                    <!-- Department -->

                    <div>

                        <label class="block mb-2 text-sm font-bold text-stone-200">
                            Department
                        </label>

                        <select
                            name="department"
                            required
                            class="w-full bg-stone-900 border border-stone-800 rounded-xl px-4 py-3.5 text-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-500/50 focus:border-teal-500 transition-all duration-200 cursor-pointer appearance-none"
                        >

                            <option
                                value="Maintenance"
                                <%= worker.department === "Maintenance" ? "selected" : "" %>
                            >
                                Maintenance
                            </option>

                            <option
                                value="Plumbing"
                                <%= worker.department === "Plumbing" ? "selected" : "" %>
                            >
                                Plumbing
                            </option>

                            <option
                                value="Electrical"
                                <%= worker.department === "Electrical" ? "selected" : "" %>
                            >
                                Electrical
                            </option>

                            <option
                                value="Cleaning"
                                <%= worker.department === "Cleaning" ? "selected" : "" %>
                            >
                                Cleaning
                            </option>

                            <option
                                value="Internet"
                                <%= worker.department === "Internet" ? "selected" : "" %>
                            >
                                Internet
                            </option>

                        </select>

                    </div>


                    <!-- Buttons -->

                    <div class="flex gap-4 pt-6">

                        <a
                            href="/admin/workers"
                            class="flex-1 text-center bg-stone-900 hover:bg-stone-200 text-stone-200 rounded-xl py-4 font-bold transition-all duration-300"
                        >
                            Cancel
                        </a>


                        <button
                            type="submit"
                            class="flex-1 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-4 font-bold transition-all duration-300 shadow-lg shadow-teal-600/20 hover:shadow-teal-600/40 hover:-translate-y-0.5"
                        >
                            Save Changes
                        </button>

                    </div>


                </form>


            </div>

        </div>


    </main>


    <%- include("../partials/footer") %>


</body>

</html>