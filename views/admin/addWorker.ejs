<!DOCTYPE html>
<html lang="en">

<head>

    <title>Add Worker</title>

    <%- include("../partials/head") %>

</head>

<body class="bg-slate-950 text-white">

    <%- include("../partials/navbar") %>

    <main class="max-w-xl mx-auto py-10 px-6">

        <h1 class="text-3xl font-bold">
            Add Worker
        </h1>

        <p class="text-slate-400 mt-2 mb-8">
            Create a worker account and assign their expertise.
        </p>

        <form
            action="/admin/workers"
            method="POST"
            class="bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-5"
        >

            <input
                type="text"
                name="name"
                placeholder="Worker Name"
                required
                class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3"
            >

            <input
                type="email"
                name="email"
                placeholder="Email Address"
                required
                class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3"
            >

            <input
                type="password"
                name="password"
                placeholder="Password"
                required
                class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3"
            >

            <select
                name="department"
                required
                class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-3"
            >

                <option value="">Select Expertise</option>

                <option value="Plumbing">Plumbing</option>
                <option value="Electrical">Electrical</option>
                <option value="Cleaning">Cleaning</option>
                <option value="Internet">Internet</option>
                <option value="Maintenance">Maintenance</option>

            </select>

            <button
                type="submit"
                class="w-full bg-blue-600 hover:bg-blue-700 rounded-lg py-3 font-semibold"
            >
                Create Worker
            </button>

        </form>

    </main>

    <%- include("../partials/footer") %>

</body>

</html>