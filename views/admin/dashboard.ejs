<!DOCTYPE html>
<html lang="en">

<head>

    <title>Admin Dashboard</title>

    <%- include("../partials/head") %>

</head>


<body class="bg-slate-950 text-white min-h-screen">

    <%- include("../partials/navbar") %>


    <main class="max-w-7xl mx-auto py-10 px-6">


        <!-- Header -->

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-10">

            <div>

                <p class="text-blue-400 font-medium mb-2">
                    AASHRAY ADMIN
                </p>

                <h1 class="text-4xl font-bold tracking-tight">
                    Admin Dashboard
                </h1>

                <p class="text-slate-400 mt-2">
                    Monitor hostel complaints, workers and resolution progress.
                </p>

            </div>


            <a
                href="/admin/workers"
                class="inline-flex items-center justify-center px-5 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition"
            >
                Manage Workers
            </a>

        </div>


        <!-- Statistics -->

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5">


            <!-- Total -->

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">

                <p class="text-slate-400 text-sm">
                    Total Complaints
                </p>

                <h2 class="text-4xl font-bold mt-3">
                    <%= total %>
                </h2>

            </div>


            <!-- Pending -->

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">

                <p class="text-slate-400 text-sm">
                    Pending
                </p>

                <h2 class="text-4xl font-bold mt-3">
                    <%= pending %>
                </h2>

            </div>


            <!-- In Progress -->

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">

                <p class="text-slate-400 text-sm">
                    In Progress
                </p>

                <h2 class="text-4xl font-bold mt-3">
                    <%= inProgress %>
                </h2>

            </div>


            <!-- Resolved -->

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">

                <p class="text-slate-400 text-sm">
                    Resolved
                </p>

                <h2 class="text-4xl font-bold mt-3">
                    <%= resolved %>
                </h2>

            </div>


            <!-- Average Rating -->

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">

                <p class="text-slate-400 text-sm">
                    Average Rating
                </p>

                <h2 class="text-4xl font-bold mt-3">

                    <%= averageRating %>

                    <span class="text-yellow-400 text-2xl">
                        ★
                    </span>

                </h2>

                <p class="text-slate-500 text-sm mt-2">
                    Out of 5
                </p>

            </div>


        </div>


        <!-- Recent Complaints -->

        <div class="mt-12">


            <div class="mb-6">

                <h2 class="text-2xl font-bold">
                    Recent Complaints
                </h2>

                <p class="text-slate-400 mt-1">
                    Monitor complaints, workers and their complete timeline.
                </p>

            </div>


            <% if (complaints.length === 0) { %>


                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-10 text-center">

                    <h3 class="text-lg font-semibold">
                        No complaints found
                    </h3>

                    <p class="text-slate-400 mt-2">
                        New complaints will appear here.
                    </p>

                </div>


            <% } else { %>


                <div class="space-y-5">


                    <% complaints.forEach((complaint) => { %>


                        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 hover:border-slate-700 transition">


                            <!-- Top Section -->

                            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-6">


                                <!-- Complaint Information -->

                                <div class="flex-1">


                                    <div class="flex flex-wrap items-center gap-3">

                                        <h3 class="text-xl font-semibold">
                                            <%= complaint.title %>
                                        </h3>


                                        <span class="text-xs px-3 py-1 rounded-full bg-slate-800 text-slate-300">
                                            <%= complaint.category %>
                                        </span>

                                    </div>


                                    <p class="text-slate-400 mt-2">
                                        <%= complaint.description %>
                                    </p>


                                    <!-- Details -->

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 mt-6">


                                        <!-- Student -->

                                        <div>

                                            <p class="text-xs text-slate-500 uppercase tracking-wide">
                                                Student
                                            </p>

                                            <p class="text-sm text-slate-300 mt-1">

                                                <% if (complaint.user) { %>

                                                    <%= complaint.user.name %>

                                                <% } else { %>

                                                    Unknown

                                                <% } %>

                                            </p>

                                        </div>


                                        <!-- Room -->

                                        <div>

                                            <p class="text-xs text-slate-500 uppercase tracking-wide">
                                                Room
                                            </p>

                                            <p class="text-sm text-slate-300 mt-1">

                                                <% if (complaint.user && complaint.user.roomNumber) { %>

                                                    <%= complaint.user.roomNumber %>

                                                <% } else { %>

                                                    <%= complaint.roomNumber || "N/A" %>

                                                <% } %>

                                            </p>

                                        </div>


                                        <!-- Worker -->

                                        <div>

                                            <p class="text-xs text-slate-500 uppercase tracking-wide">
                                                Assigned Worker
                                            </p>

                                            <p class="text-sm text-slate-300 mt-1">

                                                <% if (complaint.assignedTo) { %>

                                                    <%= complaint.assignedTo.name %>

                                                <% } else { %>

                                                    <span class="text-yellow-400">
                                                        Not assigned
                                                    </span>

                                                <% } %>

                                            </p>

                                        </div>


                                        <!-- Department -->

                                        <div>

                                            <p class="text-xs text-slate-500 uppercase tracking-wide">
                                                Department
                                            </p>

                                            <p class="text-sm text-slate-300 mt-1">

                                                <% if (complaint.assignedTo && complaint.assignedTo.department) { %>

                                                    <%= complaint.assignedTo.department %>

                                                <% } else { %>

                                                    N/A

                                                <% } %>

                                            </p>

                                        </div>


                                    </div>


                                </div>


                                <!-- Status -->

                                <div class="shrink-0">


                                    <% if (complaint.status === "Pending") { %>

                                        <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">
                                            Pending
                                        </span>


                                    <% } else if (complaint.status === "In Progress") { %>

                                        <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
                                            In Progress
                                        </span>


                                    <% } else if (complaint.status === "Resolved") { %>

                                        <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20">
                                            Resolved
                                        </span>


                                    <% } else { %>

                                        <span class="inline-flex px-4 py-2 rounded-full text-sm font-medium bg-slate-800 text-slate-300">
                                            <%= complaint.status %>
                                        </span>

                                    <% } %>


                                </div>


                            </div>


                            <!-- Timeline -->

                            <div class="mt-8 pt-6 border-t border-slate-800">


                                <p class="text-xs text-slate-500 uppercase tracking-wide mb-5">
                                    Complaint Timeline
                                </p>


                                <div class="grid grid-cols-1 md:grid-cols-4 gap-5">


                                    <!-- Raised -->

                                    <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                                        <p class="text-sm font-medium text-slate-300">
                                            Complaint Raised
                                        </p>

                                        <% if (complaint.createdAt) { %>

                                            <p class="text-xs text-slate-500 mt-2">
                                                <%= new Date(complaint.createdAt).toLocaleString("en-IN") %>
                                            </p>

                                        <% } else { %>

                                            <p class="text-xs text-slate-600 mt-2">
                                                Not available
                                            </p>

                                        <% } %>

                                    </div>


                                    <!-- Assigned -->

                                    <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                                        <p class="text-sm font-medium text-slate-300">
                                            Worker Assigned
                                        </p>

                                        <% if (complaint.assignedAt) { %>

                                            <p class="text-xs text-slate-500 mt-2">
                                                <%= new Date(complaint.assignedAt).toLocaleString("en-IN") %>
                                            </p>

                                        <% } else { %>

                                            <p class="text-xs text-yellow-500 mt-2">
                                                Not assigned
                                            </p>

                                        <% } %>

                                    </div>


                                    <!-- Started -->

                                    <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                                        <p class="text-sm font-medium text-slate-300">
                                            Task Started
                                        </p>

                                        <% if (complaint.startedAt) { %>

                                            <p class="text-xs text-slate-500 mt-2">
                                                <%= new Date(complaint.startedAt).toLocaleString("en-IN") %>
                                            </p>

                                        <% } else { %>

                                            <p class="text-xs text-slate-600 mt-2">
                                                Not started
                                            </p>

                                        <% } %>

                                    </div>


                                    <!-- Resolved -->

                                    <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">

                                        <p class="text-sm font-medium text-slate-300">
                                            Resolved
                                        </p>

                                        <% if (complaint.resolvedAt) { %>

                                            <p class="text-xs text-slate-500 mt-2">
                                                <%= new Date(complaint.resolvedAt).toLocaleString("en-IN") %>
                                            </p>

                                        <% } else { %>

                                            <p class="text-xs text-slate-600 mt-2">
                                                Not resolved
                                            </p>

                                        <% } %>

                                    </div>


                                </div>


                            </div>


                        </div>


                    <% }) %>


                </div>


            <% } %>


        </div>


        <!-- Student Feedback -->

        <div class="mt-12">


            <div class="mb-6">

                <h2 class="text-2xl font-bold">
                    Student Feedback
                </h2>

                <p class="text-slate-400 mt-1">
                    Reviews submitted after complaints were resolved.
                </p>

            </div>


            <% if (feedbacks.length === 0) { %>


                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center">

                    <p class="text-slate-400">
                        No feedback submitted yet.
                    </p>

                </div>


            <% } else { %>


                <div class="space-y-4">


                    <% feedbacks.forEach((feedback) => { %>


                        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">


                            <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-5">


                                <!-- Feedback -->

                                <div>


                                    <% if (feedback.complaint) { %>

                                        <h3 class="text-lg font-semibold">
                                            <%= feedback.complaint.title %>
                                        </h3>

                                    <% } %>


                                    <% if (feedback.student) { %>

                                        <p class="text-sm text-slate-500 mt-2">

                                            Student:

                                            <span class="text-slate-300">
                                                <%= feedback.student.name %>
                                            </span>

                                        </p>

                                    <% } %>


                                    <% if (feedback.comment) { %>

                                        <p class="text-slate-400 mt-4">
                                            "<%= feedback.comment %>"
                                        </p>

                                    <% } else { %>

                                        <p class="text-slate-500 mt-4">
                                            No written comment.
                                        </p>

                                    <% } %>


                                </div>


                                <!-- Rating -->

                                <div class="shrink-0">


                                    <p class="text-yellow-400 text-lg tracking-wide">

                                        <% for (let i = 0; i < feedback.rating; i++) { %>

                                            ⭐

                                        <% } %>

                                    </p>


                                    <p class="text-xs text-slate-500 mt-1">
                                        <%= feedback.rating %>/5
                                    </p>


                                </div>


                            </div>


                        </div>


                    <% }) %>


                </div>


            <% } %>


        </div>


    </main>


    <%- include("../partials/footer") %>


</body>

</html>