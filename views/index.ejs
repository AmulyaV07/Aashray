<!DOCTYPE html>
<html lang="en">

<head>

    <title>AASHRAY</title>

    <%- include("./partials/head") %>

</head>

<body class="bg-slate-950 text-white font-[Inter]">

    <%- include("./partials/navbar") %>

    <main class="max-w-7xl mx-auto px-8">
        <section class="min-h-[85vh] flex items-center">

    <div class="grid grid-cols-2 gap-16 items-center w-full">

        <div>

            <p class="text-blue-500 font-semibold mb-4">
                Smart Hostel Complaint Management
            </p>

            <h1 class="text-6xl font-bold leading-tight">
                Report hostel issues.<br>
                Track every update.
            </h1>

            <p class="text-slate-400 text-lg mt-6 leading-8">
                Raise complaints in seconds, monitor their progress in real time,
                and know exactly when they're resolved.
            </p>

            <div class="flex gap-4 mt-10">

                <a href="/auth/register"
                   class="bg-blue-600 hover:bg-blue-700 px-7 py-3 rounded-xl transition-all duration-200 font-semibold">
                    Get Started
                </a>

                <a href="/auth/login"
                   class="border border-slate-700 hover:border-blue-500 px-7 py-3 rounded-xl transition-all duration-200">
                    Login
                </a>

            </div>

        </div>

        <div>
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl">

    <div class="flex justify-between items-center mb-6">

        <h2 class="text-xl font-semibold">
            Dashboard
        </h2>

        <span class="text-sm text-green-400">
            ● Online
        </span>

    </div>

    <div class="grid grid-cols-2 gap-4">

        <div class="bg-slate-800 rounded-xl p-4">

            <p class="text-slate-400 text-sm">
                Pending
            </p>

            <h3 class="text-3xl font-bold mt-2">
                12
            </h3>

        </div>

        <div class="bg-slate-800 rounded-xl p-4">

            <p class="text-slate-400 text-sm">
                Resolved
            </p>

            <h3 class="text-3xl font-bold mt-2">
                48
            </h3>

        </div>

    </div>

    <div class="mt-6 bg-slate-800 rounded-xl p-4">

        <h3 class="font-semibold mb-4">
            Recent Complaints
        </h3>

        <div class="space-y-3">

            <div class="flex justify-between">

                <span>Water Leakage</span>

                <span class="text-yellow-400">
                    Pending
                </span>

            </div>

            <div class="flex justify-between">

                <span>Wi-Fi Issue</span>

                <span class="text-green-400">
                    Resolved
                </span>

            </div>

            <div class="flex justify-between">

                <span>Room Cleaning</span>

                <span class="text-blue-400">
                    In Progress
                </span>

            </div>

        </div>

    </div>

</div>
        </div>

    </div>

</section>
    </main>

    <%- include("./partials/footer") %>

</body>

</html>