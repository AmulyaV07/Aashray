<!DOCTYPE html>
<html lang="en">

<head>

    <title>AASHRAY</title>

    <%- include("./partials/head") %>

</head>

<body class="bg-stone-950 text-stone-200 font-[Inter] antialiased selection:bg-teal-900 selection:text-teal-100">



    <!-- Background Image Overlay -->
    <div class="fixed inset-0 z-[-1]">
        <img src="/images/image%20copy.png" alt="Background"
            class="w-full h-full object-cover opacity-[0.16] mix-blend-luminosity">
        <div class="absolute inset-0 bg-gradient-to-b from-stone-950/50 via-stone-950/80 to-stone-950"></div>
    </div>

    <main class="max-w-7xl mx-auto px-8 relative z-10">
        <section class="min-h-[85vh] flex flex-col items-center justify-center py-20 text-center">

            <div
                class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-stone-900 border border-stone-800 shadow-sm mb-8 hover:bg-stone-800 transition-colors">
                <span class="w-2.5 h-2.5 rounded-full bg-teal-500 animate-pulse"></span>
                <p class="text-teal-400 text-sm font-semibold tracking-wide">
                    Next-Generation Hostel Complaint Management
                </p>
            </div>

            <h1
                class="text-6xl md:text-7xl lg:text-8xl font-extrabold leading-[1.1] text-white tracking-tight max-w-4xl">
                Report hostel issues.<br>
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-emerald-400 to-teal-500">Track
                    every update.</span>
            </h1>

            <p class="text-stone-400 text-xl md:text-2xl mt-8 leading-relaxed max-w-2xl">
                Raise complaints in seconds, monitor their progress in real time,
                and know exactly when they're resolved. Experience a seamless and hassle-free campus life.
            </p>

            <!-- Decorative stats/features so it doesn't look empty -->
            <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12 mt-12 text-stone-500 font-medium">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">⚡</span> Quick Reporting
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-2xl">📱</span> Real-time Tracking
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-2xl">🛠️</span> Faster Resolutions
                </div>
            </div>

            <div class="flex flex-wrap justify-center gap-5 mt-14">

                <a href="/auth/register"
                    class="bg-teal-600 hover:bg-teal-500 text-white px-10 py-4 rounded-2xl transition-all duration-300 font-bold text-lg shadow-lg shadow-teal-900/30 hover:shadow-teal-900/50 hover:-translate-y-1">
                    Get Started Now
                </a>

                <a href="/auth/login"
                    class="bg-stone-900/50 backdrop-blur-sm border-2 border-stone-800 hover:border-teal-500 hover:bg-stone-900 hover:text-teal-400 text-stone-200 px-10 py-4 rounded-2xl transition-all duration-300 font-bold text-lg hover:-translate-y-1">
                    Login
                </a>

            </div>

        </section>
    </main>

    <%- include("./partials/footer") %>

</body>

</html>